#!/usr/bin/env python3
"""Reproduce the debt schedules and core cash checks from financials.json."""
import csv, json, math
from pathlib import Path

ROOT = Path(__file__).resolve().parent
DATA = json.loads((ROOT / "financials.json").read_text())

def money(x): return round(float(x), 2)

def payment(principal, annual=.09, months=60):
    r = annual / 12
    return principal * r / (1 - (1+r) ** -months)

rows=[]
for scenario in DATA["debt_scenarios"]:
    principal = scenario["principal"]
    io = principal * DATA["financing_assumptions"]["annual_interest_rate"] / 12
    amort = payment(principal)
    for month in range(1, 73):
        if month <= 12:
            interest, principal_paid, scheduled = io, 0, io
        else:
            balance_before = principal if month == 13 else balance
            interest = balance_before * .09 / 12
            principal_paid = amort - interest
            scheduled = amort
        if month <= 12:
            balance = principal
        else:
            balance = max(0.0, balance_before - principal_paid)
        rows.append({"tier": principal, "month": month, "opening_balance": money(principal if month == 1 else prior),
                     "scheduled_payment": money(scheduled), "interest": money(interest),
                     "principal_paid": money(principal_paid), "ending_balance": money(balance)})
        prior = balance
    expected_io = money(io)
    expected_amort = money(amort)
    recorded = next(x for x in DATA["debt_scenarios"] if x["principal"] == principal)
    assert expected_io == money(recorded["first_year_monthly_interest"]), (principal, expected_io)
    assert expected_amort == money(recorded["amortizing_monthly_payment"]), (principal, expected_amort)

out = ROOT / "debt-schedule.csv"
with out.open("w", newline="") as f:
    writer=csv.DictWriter(f, fieldnames=list(rows[0]))
    writer.writeheader(); writer.writerows(rows)

# Reconcile published 240k bridge totals without changing the source model.
bridge = DATA["cash_bridge_240k_day_one_draw"]
base = sum(x["center_operating_cash_base"] for x in bridge["schedule"])
down = sum(x["center_operating_cash_downside"] for x in bridge["schedule"])
spend = sum(x["non_center_spend"] for x in bridge["schedule"])
interest = sum(x["interest_only"] for x in bridge["schedule"])
assert money(base) == -74520.00 and money(down) == -132480.00
assert money(spend) == 115000.00 and money(interest) == 21600.00
assert money(240000 + base - spend - interest) == bridge["ending_cash_base"]
assert money(240000 + down - spend - interest) == bridge["ending_cash_downside"]
print(f"wrote {out} ({len(rows)} debt rows)")
for p in (140000,240000,500000):
    s=next(x for x in DATA["debt_scenarios"] if x["principal"]==p)
    print(f"{p}: IO={s['first_year_monthly_interest']:.2f} amort={s['amortizing_monthly_payment']:.2f} scheduled={s['scheduled_total_including_first_year_interest']:.2f}")
print(f"240k bridge: base={base:.2f} downside={down:.2f} spend={spend:.2f} interest={interest:.2f}")

endstream
endobj
