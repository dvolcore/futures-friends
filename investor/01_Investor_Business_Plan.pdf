#!/usr/bin/env python3
"""Transparent expansion repayment scenarios; planning sensitivities, not a forecast."""
from decimal import Decimal, ROUND_HALF_UP, getcontext
import csv, json
from pathlib import Path
getcontext().prec = 28
D = Decimal
ROOT = Path(__file__).resolve().parent
Q = lambda x: D(str(x)).quantize(D("0.01"), rounding=ROUND_HALF_UP)

PRICES = {"home": (D("1495"), D("89")), "starter": (D("2995"), D("229")), "complete": (D("5995"), D("349"))}
MIX = {"home": D("0.40"), "starter": D("0.40"), "complete": D("0.20")}
center_base = [-16780,-16780,-15100,-11740,-11740,-5020,-5020,-2500,860,860,3380,5060]
center_down = [-16780,-16780,-15940,-14260,-14260,-10900,-10900,-9220,-7540,-7540,-5020,-3340]
noncenter_spend = [14000,14000,13000,10000,10000,13000,8000,8000,8000,8000,4500,4500]

def new_sites(scenario, month):
    # month is 1-indexed; church equivalents are deliberately priced as starter/complete pending quote.
    if scenario == "measured":
        return 0 if month < 4 else (1 if month <= 8 else 0)
    if scenario == "delayed":
        return 0 if month < 7 else (1 if month <= 11 else 0)
    if scenario == "growth":
        return 0 if month < 4 else (2 if month <= 8 else 1)
    raise ValueError(scenario)

def run(scenario, recurring_margin, setup_rate=D("0.10")):
    active = D("0"); rows=[]
    for month in range(1,25):
        acquired = D(new_sites(scenario, month))
        churned = active * D("0.02") if month > 1 else D("0")
        opening = active
        active = active - churned + acquired
        # weighted equivalent site price; this includes church equivalents only as a sensitivity.
        setup_gross = sum(PRICES[k][0] * MIX[k] for k in MIX) * acquired
        recurring_gross = sum(PRICES[k][1] * MIX[k] for k in MIX) * active
        setup_contribution = setup_gross * setup_rate
        recurring_net = recurring_gross * recurring_margin
        launch = 7 if scenario == "delayed" else 4
        b2b_overhead = D("500") if month >= launch else D("0")
        provider_net = setup_contribution + recurring_net - b2b_overhead
        rows.append({"month":month,"opening_active_sites":opening,"new_sites":acquired,"churned_sites":churned,"ending_active_sites":active,"setup_gross":setup_gross,"recurring_gross":recurring_gross,"setup_contribution":setup_contribution,"recurring_net":recurring_net,"b2b_overhead":b2b_overhead,"provider_net_before_debt":provider_net})
    return rows

def main():
    # No file is mutated except generated artifacts; center steady-state is conditional after month 12.
    allrows=[]
    scenarios={}
    for name in ("measured","delayed","growth"):
      for margin in (D("0.40"),D("0.60")):
       for setup_rate in (D("0.10"),D("0")):
        key=f"{name}_{int(margin*100)}pct_{int(setup_rate*100)}pct_setup"
        scenarios[key]=(name,margin,setup_rate)
    for key, (name, contrib, setup_rate) in scenarios.items():
        rows=run(name, contrib, setup_rate)
        active0 = rows[3]
        if name == "growth" and contrib == D("0.60") and setup_rate == D("0.10"):
            assert Q(active0["recurring_gross"]) == D("394.00") and Q(active0["recurring_net"]) == D("236.40")
            assert Q(rows[23]["ending_active_sites"]) == D("20.76")
        for r in rows:
            m=r["month"]
            base=D(center_base[m-1]) if m<=12 else D("5060")
            down=D(center_down[m-1]) if m<=12 else D("-3340")
            io=D("1800") if m<=12 else D("4982.01")
            for label, center in (("base_center_34",base),("downside_center_24",down)):
                net=center+r["provider_net_before_debt"]-io
                r[label+"_before_debt"]=center+r["provider_net_before_debt"]
                r[label+"_debt_service"]=io
                r[label+"_net_after_debt"]=net
            r["noncenter_spend"] = D(noncenter_spend[m-1]) if m <= 12 else D("0")
            r["base_ending_cash"] = D("240000") + sum(x["base_center_34_net_after_debt"]-x.get("noncenter_spend",0) for x in rows[:m])
            r["downside_ending_cash"] = D("240000") + sum(x["downside_center_24_net_after_debt"]-x.get("noncenter_spend",0) for x in rows[:m])
        for r in rows: r["scenario"]=name; r["case"]=key; r["setup_rate"]=setup_rate; allrows.append(r)
    fields=list(allrows[0])
    with (ROOT/"partner-repayment-monthly.csv").open("w",newline="") as f:
        w=csv.DictWriter(f,fieldnames=fields); w.writeheader()
        for r in allrows: w.writerow({k: Q(v) if isinstance(v,Decimal) else v for k,v in r.items()})
    # Required active sites for 1.25x debt coverage after month 12, using recurring contribution only.
    weighted_monthly=D("0.4")*D("89")+D("0.4")*D("229")+D("0.2")*D("349")
    req={}
    for contrib in (D("0.40"),D("0.60")):
        # monthly B2B overhead and center steady state; setup receipts are excluded from residual coverage.
        for center_name, center in (("base_34",D("5060")),("downside_24",D("-3340"))):
            req[f"{center_name}_{int(contrib*100)}pct"] = int(((D("1.25")*D("4982.01")+D("500")-center)/(weighted_monthly*contrib)).to_integral_value(rounding="ROUND_CEILING"))
    out={"status":"planning sensitivity; noncontractual and not underwritten","inputs":{"opening_cash":"240000","prices":{k:{"setup":str(v[0]),"monthly":str(v[1])} for k,v in PRICES.items()},"mix":{k:str(v) for k,v in MIX.items()},"recurring_contribution_tests":["0.40","0.60"],"setup_contribution_tests":["0.10","0.00"],"churn":"2% monthly active subscriptions","b2b_overhead":"$500/month from each rollout launch; delayed starts month 7","launch_months":{"measured":4,"delayed":7,"growth":4},"noncenter_spend_first12":str(sum(noncenter_spend)),"debt":"$240,000; 9%; 12 IO months at $1,800, then 60 months at $4,982.01"},"weighted_site_monthly_gross":str(weighted_monthly),"required_active_sites_for_1_25x_after_month12":req,"scenarios":{}}
    for name in scenarios:
        rs=[r for r in allrows if r["case"]==name]
        out["scenarios"][name]={"month12_active_sites":str(rs[11]["ending_active_sites"]),"month24_active_sites":str(rs[23]["ending_active_sites"]),"month12_base_net_after_debt":str(Q(rs[11]["base_center_34_net_after_debt"])),"month12_downside_net_after_debt":str(Q(rs[11]["downside_center_24_net_after_debt"])),"month24_base_net_after_debt":str(Q(rs[23]["base_center_34_net_after_debt"])),"month24_downside_net_after_debt":str(Q(rs[23]["downside_center_24_net_after_debt"])),"month12_base_ending_cash":str(Q(rs[11]["base_ending_cash"])),"month12_downside_ending_cash":str(Q(rs[11]["downside_ending_cash"])),"month24_base_ending_cash":str(Q(rs[23]["base_ending_cash"])),"month24_downside_ending_cash":str(Q(rs[23]["downside_ending_cash"])),"month24_recurring_gross":str(Q(rs[23]["recurring_gross"])),"month24_recurring_net":str(Q(rs[23]["recurring_net"]))}
    (ROOT/"partner-repayment-model.json").write_text(json.dumps(out,indent=2)+"\n")
    print(json.dumps(out,indent=2))
if __name__ == "__main__": main()

endstream
endobj
